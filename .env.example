# Copy to `.env.local` and fill in. `.env.local` is untracked.
#
# Everything prefixed with VITE_ is embedded in the built JavaScript and is
# readable by anyone who loads the app. Never put a client secret here.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The database records are stored in, and the only record store the app has.
# Both values come from the Supabase dashboard, under Project Settings -> API.
#
# The publishable key is public by design: it identifies the project, not the
# caller. Access is decided by Supabase Auth and Row Level Security in the
# database, so publishing this key grants nothing on its own.
#
# NEVER put the service_role key (or an `sb_secret_...` key) here. It bypasses
# every RLS policy. The app inspects the key and refuses to start if it finds
# one, but the real protection is not pasting it in the first place.
#
# VITE_SUPABASE_ANON_KEY is also read, for deployments configured before
# Supabase renamed this key. Set only one of the two.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Which identity source to use. One of:
#   supabase  Supabase Auth, with the role read from public.profiles. Chosen
#             automatically whenever the Supabase variables above are set.
#   entra     Microsoft single sign-on. Needs the app registration below.
#   local     Offline fallback: passwords derived from the person's roster
#             entry, plus the built-in administrator. Development only, and
#             never selected automatically while Supabase is configured.
#
# Leave blank for automatic selection (supabase, then entra, then local).
VITE_AUTH_MODE=

# Entra app registration, used for single sign-on. Public identifiers, not
# secrets.
#
# Leave both empty to sign in with roster passwords instead.
#
# The registration needs: single-page application platform, a redirect URI
# matching the deployed origin, and delegated User.Read.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# The offline bootstrap administrator, used only under VITE_AUTH_MODE=local.
#
# The built-in password exists in development builds alone: a production build
# that sets no VITE_ADMIN_PASSWORD has no password in the bundle and the
# account is disabled outright, because anything compared in a browser is
# public to whoever opens it. Set this only if a deployment genuinely needs
# the offline account, and never to the Supabase admin's password.
VITE_ADMIN_EMAIL=
VITE_ADMIN_NAME=
VITE_ADMIN_PASSWORD=
