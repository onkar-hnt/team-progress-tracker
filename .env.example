# Copy to `.env.local` and fill in. `.env.local` is untracked.
#
# Everything prefixed with VITE_ is embedded in the built JavaScript and is
# readable by anyone who loads the app. Never put a client secret here.

# `mock` uses the fixtures in src/data. `sharepoint-excel` uses the workbook.
VITE_DATA_SOURCE=mock

# Artificial delay in milliseconds, for checking loading and skeleton states.
VITE_MOCK_LATENCY_MS=0

# Sharing URL of Team-Progress-Tracker.xlsx. Treat as a credential: the link
# alone grants access to the file.
VITE_SHAREPOINT_WORKBOOK_URL=
