# Copy to `.env.local` and fill in. `.env.local` is untracked.
#
# Everything prefixed with VITE_ is embedded in the built JavaScript and is
# readable by anyone who loads the app. Never put a client secret here.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The database records will be stored in. Both values come from the Supabase
# dashboard, under Project Settings -> API.
#
# The publishable key is public by design: it identifies the project, not the
# caller. Access is decided by Supabase Auth and Row Level Security in the
# database, so publishing this key grants nothing on its own.
#
# NEVER put the service_role key (or an `sb_secret_...` key) here. It bypasses
# every RLS policy. The app inspects the key and refuses to start if it finds
# one, but the real protection is not pasting it in the first place.
#
# VITE_SUPABASE_ANON_KEY is also read, for deployments configured before
# Supabase renamed this key. Set only one of the two.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Which identity source to use. One of:
#   supabase  Supabase Auth, with the role read from public.profiles. Chosen
#             automatically whenever the Supabase variables above are set.
#   entra     Microsoft single sign-on. Needs the app registration below.
#   local     Offline fallback: accounts and passwords derived from the
#             workbook, plus the built-in administrator. Development only, and
#             never selected automatically while Supabase is configured.
#
# Leave blank for automatic selection (supabase, then entra, then local).
VITE_AUTH_MODE=

# ---------------------------------------------------------------------------
# Storage transport
# ---------------------------------------------------------------------------
# How records are stored. One of:
#   supabase         PostgreSQL through Supabase, with row-level security. The
#                    intended production source. Needs the two variables above.
#   memory-excel     temporary workbook held in memory. The current default.
#   sharepoint-excel the Admin workbook via Microsoft Graph. Needs the
#                    registration below.
#   local-excel      an .xlsx on this computer, via the OneDrive-synced copy.
#   mock             the fixtures in src/data.
#
# MIGRATION IN PROGRESS: under `supabase`, everything except mentor feedback
# is served from the database. Feedback still comes from the fixtures until it
# is moved across. The app states which is which in a banner.
#
# The deployed site sets this to `supabase` in the Pages workflow. The default
# below stays as it is so a fresh clone runs with no configuration at all.
VITE_DATA_SOURCE=memory-excel

# Artificial delay in milliseconds, for checking loading and skeleton states.
VITE_MOCK_LATENCY_MS=0

# Sharing URL of the Admin workbook. Treat as a credential: the link alone
# grants access to the file, so it is configured here rather than committed.
#
# Optional, and unused under `supabase`. Leave blank to run without a
# workbook: the Graph gateway reports itself unconfigured, the settings page
# says so, and the header hides the "Open Excel Sheet" link.
VITE_SHAREPOINT_WORKBOOK_URL=

# Entra app registration, used both for sign-in and for the Graph token the
# workbook is read and written with. Public identifiers, not secrets.
#
# Required for `sharepoint-excel`. Leave both empty to run on the in-memory
# workbook with the built-in administrator sign-in instead.
#
# The registration needs: single-page application platform, a redirect URI
# matching the deployed origin, and delegated Files.ReadWrite.All + User.Read.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# The offline bootstrap administrator, used only under VITE_AUTH_MODE=local.
#
# The built-in password exists in development builds alone: a production build
# that sets no VITE_ADMIN_PASSWORD has no password in the bundle and the
# account is disabled outright, because anything compared in a browser is
# public to whoever opens it. Set this only if a deployment genuinely needs
# the offline account, and never to the Supabase admin's password.
VITE_ADMIN_EMAIL=
VITE_ADMIN_NAME=
VITE_ADMIN_PASSWORD=
