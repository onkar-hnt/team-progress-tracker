# Environment variables the backend reads, for running it without
# appsettings.Local.json files (a container, or CI). Copy to .env and fill in.
# Double underscore is how .NET nests configuration keys.

# Every service must share this value, or a token issued by Identity will not
# validate anywhere else. Use 32 characters or more.
Jwt__SigningKey=

ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS01;Database=TeamProgressTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# The first administrator, created when the profiles table is empty.
Seed__AdminEmail=admin@handt.ai
Seed__AdminName=Administrator
Seed__AdminPassword=

# Development turns on Swagger, migrate-on-startup and seeding.
ASPNETCORE_ENVIRONMENT=Development
