# Environment for the backend. Copy to `.env` and fill in; `.env` is git-ignored.
#
# Two uses, deliberately in one file:
#
#   * `docker compose up` reads this directory's `.env` and substitutes the
#     values below into `docker-compose.yml`.
#   * Running a service directly without an appsettings.Local.json can read the
#     same names, because double underscore is how .NET nests configuration
#     keys - `Jwt__SigningKey` is `Jwt:SigningKey`.
#
# Nothing here has a working default. A stack that starts with a password
# everybody knows is worse than one that refuses to start.

# --- Required by both ---

# Every service must share this value, or a token issued by Identity will not
# validate anywhere else. Use 32 characters or more.
Jwt__SigningKey=

# The first administrator, created when the profiles table is empty.
Seed__AdminEmail=admin@handt.ai
Seed__AdminName=Administrator
Seed__AdminPassword=

# --- docker compose only ---

# SQL Server in the stack. Must satisfy the SQL Server password policy:
# 8 characters or more, from three of upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# Where the browser app is served from, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# --- Running the services directly (not compose) ---

# Compose builds its own connection string against the `sqlserver` container
# and ignores this one.
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS01;Database=TeamProgressTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# Development turns on Swagger, migrate-on-startup and seeding.
ASPNETCORE_ENVIRONMENT=Development
